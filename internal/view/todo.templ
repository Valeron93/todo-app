package view

import "fmt"
import "github.com/Valeron93/todo-app/internal/model"

templ TodoForm(text string, err string) {
	<form
		class="form todo-form"
		hx-post="/api/todo"
		hx-swap="outerHTML"
	>
		<input type="text" name="todo-action" placeholder="Enter your todo" value={ text } required/>
		<input type="submit" value="Add"/>
		@ErrorContainer(err)
	</form>
}

templ TodoItem(item model.Todo) {
	<div class="todo-item">
		<h2>{ item.Action }</h2>
		<button
			hx-delete={ fmt.Sprintf("/api/todo/%v", item.Id) }
			hx-target="closest .todo-item"
			hx-swap="outerHTML"
		>
			Delete
		</button>
	</div>
}

templ TodoTable(items []model.Todo) {
	<div id="todo-list" class="todo-list">
		for _, todo := range items {
			@TodoItem(todo)
		}
	</div>
}

templ TodoItemOutOfBand(item model.Todo) {
	<div id="todo-list" hx-swap-oob="beforeend">
		@TodoItem(item)
	</div>
}

